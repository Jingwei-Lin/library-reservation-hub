<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.comp5619.libraryreservationreviewhub.mapper.UserMapper">

    <select id="selectByUserAccount" resultType="com.comp5619.libraryreservationreviewhub.model.entity.User">
        SELECT *
        FROM Users
        WHERE "email" = #{userAccount}
    </select>

</mapper>