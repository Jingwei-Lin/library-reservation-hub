# Copy to .env (git-ignored). docker compose reads it and passes the values to the containers; the back end
# itself doesn't read .env (run outside Docker, set them as environment variables).
DB_PASSWORD=library
# Only needed for the AI assistant: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=
# Front-end origins allowed to call the API (comma-separated); Compose defaults to these two
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
